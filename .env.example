# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in the real values for LOCAL testing.
# ".env" is git-ignored and must NEVER be committed.
# For the daily cloud run, the same names go into:
#   GitHub repo → Settings → Secrets and variables → Actions → New repository secret
# ─────────────────────────────────────────────────────────────────────────────

# ─── Which sheet to write into ───────────────────────────────────────────────
# Leave BLANK to use the live tracker (id is in config.py). Set it to a test
# copy's id while getting set up, so the live sheet is never touched.
SPREADSHEET_ID=

# ─── Google Sheets access (service account) ──────────────────────────────────
# Preferred: paste the ENTIRE service-account JSON key file as a single line.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Local-only alternative: path to the key file instead of pasting it.
# (Name the file exactly "service-account.json" so .gitignore catches it.)
# GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# ─── Shopify Admin API ───────────────────────────────────────────────────────
# From: Shopify admin → Settings → Apps and sales channels → Develop apps →
#       (your app) → API credentials → Admin API access token.
SHOPIFY_ADMIN_TOKEN=

# ─── Meta (Facebook) Ads — via Composio ──────────────────────────────────────
# Composio manages the Facebook OAuth connection, so there is no Meta token to
# generate. Get the API key from the Composio dashboard, and connect the
# "Meta Ads" toolkit there (OAuth) under the user id below.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=gimi-gimi

# Fallback only: if you ever switch Meta back to the direct Marketing API,
# set this instead of COMPOSIO_API_KEY (a System User token with ads_read).
# META_ACCESS_TOKEN=

# ─── Email (SMTP) for the daily summary ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=parth@mealofthemoment.com
