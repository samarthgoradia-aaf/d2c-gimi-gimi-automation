# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in the real values for LOCAL testing.
# ".env" is git-ignored and must NEVER be committed.
# For the daily cloud run, the same names go into:
#   GitHub repo → Settings → Secrets and variables → Actions → New repository secret
# ─────────────────────────────────────────────────────────────────────────────

# ─── Google Sheets access (service account) ──────────────────────────────────
# Preferred: paste the ENTIRE service-account JSON key file as a single line.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Local-only alternative: path to the key file instead of pasting it.
# (Name the file exactly "service-account.json" so .gitignore catches it.)
# GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# ─── Shopify Admin API ───────────────────────────────────────────────────────
# From: Shopify admin → Settings → Apps and sales channels → Develop apps →
#       (your app) → API credentials → Admin API access token.
SHOPIFY_ADMIN_TOKEN=

# ─── Meta (Facebook) Marketing API ───────────────────────────────────────────
# A System User access token with the "ads_read" permission, generated in
# Meta Business Settings → Users → System users. Should be non-expiring.
META_ACCESS_TOKEN=

# ─── Email (SMTP) for the daily summary ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=parth@mealofthemoment.com
